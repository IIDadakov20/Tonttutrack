@using Tonttutrack.PL.Models;
@model DeviceConnectionViewModelcs;

<div class="mx-5 w-100 mt-4">
    <form asp-action="Connect" asp-controller="TrackerDevice" method="post" class="d-md-inline-flex col-xl-7 col-md-12 justify-content-md-around" style="height:108px">
        <div class="align-self-start">
            <label asp-for="Code">Code</label>
            <input asp-for="Code" class="form-control"/>
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="align-self-start">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" class="form-control"/>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="align-self-center">
            <input type="checkbox" class="form-check-input mx-2">
            <label class="form-check-label">Save device</label>
        </div>
        <div class="row align-self-center">
            <div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">Connect</button>
            </div>
        </div>
    </form>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}