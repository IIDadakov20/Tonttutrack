@{
ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="~/css/homepage.css" />

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-container">
        <div class="hero-content">
            <div class="hero-text">
                <h1 class="hero-heading">Real-Time GPS Tracking & Route Statistics.</h1>
                <p class="hero-lead">Discover the ultimate tool for navigating your world with precision. Our user-friendly web app offers a powerful combination of real-time GPS tracking and route statistics.</p>
                <a class="btn hero-btn" href="~/Map/MapTrackerLayout">Join for free</a>
            </div>
            <div class="hero-image-container">
                <img src="~/assets/homepagePhoto1.jpg" class="hero-image" alt="App Image">
            </div>
        </div>
    </div>
</section>

<!-- Photo Section -->
<section class="photo-section">
    <div class="photo-container">
        <div class="photo-box">
            <img src="~/assets/instruction1.jpg" class="photo-image" alt="Step 1">
            <div class="overlay">
                <p class="overlay-text">Connect the transmitter device to a USB power source and the receiver device to your computer</p>
            </div>
            <p class="photo-text">Step One</p>
        </div>
        <div class="photo-box">
            <img src="~/assets/instruction2.jpg" class="photo-image" alt="Step 2">
            <div class="overlay">
                <p class="overlay-text">Make sure you are logged into your account. If you don't have an account, you can create one</p>
            </div>
            <p class="photo-text">Step Two</p>
        </div>
        <div class="photo-box">
            <img src="~/assets/instruction3.jpg" class="photo-image" alt="Step 3">
            <div class="overlay">
                <p class="overlay-text">Enter the code of the transmitter device and the device password which have been given to you</p>
            </div>
            <p class="photo-text">Step Three</p>
        </div>
    </div>
</section>