﻿<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/bootstrap-grid.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/homepage.css" />

</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col">
                <div class="hero-section d-flex align-items-center">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <h1 class="hero-heading">The leading family safety and location-sharing app.</h1> 
                                <p class="hero-lead">Protect each family member with advanced driving, digital, and location safety features. Choose the plan that fits your family's size and life stage.</p>
                                <div class="hero-buttons">
                                    <a class="btn btn-primary btn-lg hero-btn" href="~/Authentication/Login">Join for free</a>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <img src="~/assets/preview.png" class="img-fluid rounded-3 hero-image" alt="App Image">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col">
                <div class="photo-section">
                    <div class="container">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="photo-box">
                                    <div class="photo-container">
                                        <img src="~/assets/photo1.jpg" class="img-fluid photo-image" alt="Photo 1">
                                        <div class="overlay photo-overlay">
                                            <div class="overlay-text photo-overlay-text">Safety First</div>
                                        </div>
                                    </div>
                                    <p class="photo-text">Ensure your family's safety with our advanced tracking features.</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="photo-box">
                                    <div class="photo-container">
                                        <img src="~/assets/photo2.jpg" class="img-fluid photo-image" alt="Photo 2">
                                        <div class="overlay photo-overlay">
                                            <div class="overlay-text photo-overlay-text">Stay Connected</div>
                                        </div>
                                    </div>
                                    <p class="photo-text">Keep in touch with your loved ones no matter where they are.</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="photo-box">
                                    <div class="photo-container">
                                        <img src="~/assets/photo3.jpg" class="img-fluid photo-image" alt="Photo 3">
                                        <div class="overlay photo-overlay">
                                            <div class="overlay-text photo-overlay-text">Peace of Mind</div>
                                        </div>
                                    </div>
                                    <p class="photo-text">Gain peace of mind knowing your family is safe and sound.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Your existing JavaScript imports or scripts if any -->
    

</body>
</html>