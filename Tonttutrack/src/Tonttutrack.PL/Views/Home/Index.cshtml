@{
    ViewData["Title"] = "Home Page";
}
<section class="hero d-flex align-items-center py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1>Heading Here</h1>
                <p class="lead">Description goes here. This is a descriptive paragraph explaining the content of the section.</p>
                <a class="btn btn-primary btn-lg" href="#">Call to Action</a>
            </div>
            <div class="col-md-6 order-md-last">
                <img src="~/images/your_image.jpg" class="img-fluid rounded-3" alt="Image description">
            </div>
        </div>
    </div>
</section>

<section class="scrollable-section py-5">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="scrollable-content">
                    <div class="image-with-text">
                        <img src="~/images/tall_image1.jpg" class="img-fluid" alt="Tall image 1">
                        <div class="text-overlay">
                            <h2>Overlay Heading</h2>
                            <p>Some overlay text here with a blurred background effect.</p>
                        </div>
                    </div>
                    <div class="image-with-text">
                        <img src="~/images/tall_image2.jpg" class="img-fluid" alt="Tall image 2">
                        <div class="text-overlay">
                            <h2>Overlay Heading</h2>
                            <p>Some overlay text here with a blurred background effect.</p>
                        </div>
                    </div>
                    <div class="image-with-text">
                        <img src="~/images/tall_image3.jpg" class="img-fluid" alt="Tall image 3">
                        <div class="text-overlay">
                            <h2>Overlay Heading</h2>
                            <p>Some overlay text here with a blurred background effect.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="additional-content py-5">
    <div class="container">
        <div class="row">
            <div class="col-md-4">
                <h3>Feature 1</h3>
                <p>Description for feature 1. Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
            </div>
            <div class="col-md-4">
                <h3>Feature 2</h3>
                <p>Description for feature 2. Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
