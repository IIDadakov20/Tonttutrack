@using Tonttutrack.SharedModels.DTO;
@model RegisterDTO;

@{
    ViewData["Title"] = "Register";
}

<home>
    <link rel="stylesheet" href="~/css/register.css" />
</home>

<div class="col d-flex align-items-center justify-content-center form">
    <div class="col-md-4 card p-3">
        <h1 class="text-center">@ViewData["Title"]</h1>
        <hr/>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Username" class="form-label">Username</label>
                <input asp-for="Username" class="form-control" autocomplete="username" aria-required="true" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" autocomplete="email" aria-required="true" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="true" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true"/>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-8">
                    <p class="m-0">Already have an account?</p>
                    <a asp-action="Login" class="text-decoration-none float-start mt-0">Sign in</a>
                </div>
                <div class="col-4">
                    <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
