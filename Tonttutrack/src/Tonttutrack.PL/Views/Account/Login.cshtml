@using Tonttutrack.SharedModels.DTO;
@model LoginDTO;

@{
    ViewData["Title"] = "Login";
}

<div class="col d-flex align-items-center justify-content-center form">
    <div class="col-md-4 cardBox p-4">
        <h1 class="text-center p-1">@ViewData["Title"]</h1>
        <hr />
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" autocomplete="email" aria-required="true" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="true" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="row align-items-center">
                <div class="col-8">
                    <p class="m-0">New to Tonttutrack?</p>
                    <a asp-action="Register" class="text-decoration-none float-start mt-0">Create an account</a>
                </div>
                <div class="col-4">
                    <button id="loginSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Login</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
