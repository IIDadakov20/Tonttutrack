@{
    ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="~/css/homepage.css"/>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <div class="hero-text">
                <h1 class="hero-heading" data-translate="homePage.heroHeading">Real-Time GPS Tracking & Route Statistics.</h1>
                <p class="hero-lead" data-translate="homePage.heroLead">Discover the ultimate tool for navigating your world with precision. Our user-friendly web app offers a powerful combination of real-time GPS tracking and route statistics.</p>
                <a class="btn hero-btn" href="~/Map/MapTrackerLayout" data-translate="homePage.joinForFree">Join for free</a>
            </div>
            <div class="hero-image-container">
                <img src="@Url.Content("~/assets/homepagePhotoLight.webp")" id="homepageImage" class="hero-image" alt="App Image">
            </div>
        </div>
    </div>
</section>

<!-- Photo Section -->
<section class="photo-section">
    <div class="container">
        <div class="photo-content">
            <div class="photo-box">
                <img src="@Url.Content("~/assets/photoSection1Light.webp")" id="step-one" class="photo-image" alt="Step 1">
                <div class="overlay">
                    <p class="overlay-text" data-translate="homePage.connectText">Connect the transmitter device to a USB power source and the receiver device to your computer</p>
                </div>
                <p class="photo-text" data-translate="homePage.connect">Step One</p>
            </div>
            <div class="photo-box">
                <img src="@Url.Content("~/assets/photoSection2Light.webp")" id="step-two" class="photo-image" alt="Step 2">
                <div class="overlay">
                    <p class="overlay-text" data-translate="homePage.trackText">Make sure you are logged into your account. If you don't have an account, you can create one</p>
                </div>
                <p class="photo-text" data-translate="homePage.track">Step Two</p>
            </div>
            <div class="photo-box">
                <img src="@Url.Content("~/assets/photoSection3Light.webp")" id="step-three" class="photo-image" alt="Step 3">
                <div class="overlay">
                    <p class="overlay-text" data-translate="homePage.statsText">Enter the code of the transmitter device and the device password which have been given to you</p>
                </div>
                <p class="photo-text" data-translate="homePage.stats">Step Three</p>
            </div>
        </div>
    </div>
</section>