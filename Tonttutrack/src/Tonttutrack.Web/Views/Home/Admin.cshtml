@{
ViewData["Title"] = "Admin";
}
<link rel="stylesheet" href="~/css/adminDashboard.css" />

<div id="admin-container">
    <h2 class="device-title" data-translate="dashboard.heading">Device Management</h2>
    
    <!-- Таблица с устройствата -->
    <section class="table-section">
        <div class="device-header">
            <div class="device-column">Name</div>
            <div class="device-column">Code</div>
            <div class="device-column">Actions</div>
        </div>
        <div class="device-container">
            
        </div>
    </section>

    <section id="add-device-btn-sec" class="new-device-section">
        <div id="add-device-btn-container">
            <button id="add-device-btn">＋</button>
        </div>
    </section>

    <section class="new-device-section">
        <div class="device-add-container device-hidden">
            <div class="device-row-new">
                <div class="device-column">
                    <input type="text" id="new-device-name" class="device-edit-name input-device-name" placeholder="Device Name">
                </div>
                <div class="device-column">
                    <input type="text" id="new-device-code" placeholder="Device Code">
                </div>
                <div class="device-column">
                    <input type="password" id="new-device-password" placeholder="Device Password">
                    <button id="save-new-device-btn" class="device-btn device-save-btn">Add</button>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
<script src="~/js/admin/adminDashboard.js"></script>
}
