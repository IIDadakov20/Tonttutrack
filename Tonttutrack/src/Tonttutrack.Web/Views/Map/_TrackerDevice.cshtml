@using Tonttutrack.Domain.DTOs.Request;
@model DeviceConnectionRequestDTO

<link rel="stylesheet" href="~/css/trackerDevice.css" asp-append-version="true"/>

<div id="tracker-menu">
    <div class="tracker-content" id="connection-section">
        <form id="deviceConnectionForm">
            <div class="text-danger formErrorMessage"></div>
            <div class="form-group">
                <label asp-for="Code" class="mb-1" data-translate="tracker.code">Code</label>
                <input asp-for="Code" class="form-control"/>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="mb-1" data-translate="tracker.password">Password</label>
                <input asp-for="Password" id="passwordInput" type="password" class="form-control"/>
                <div class="form-check">
                    <input type="checkbox" id="togglePassword" class="form-check-input"/>
                    <label for="togglePassword" class="form-check-label" data-translate="tracker.showPassword">Show Password</label>
                </div>
            </div>

            <button type="submit" id="connect-btn" class="btn btn-primary w-100" data-translate="tracker.connect">Connect</button>
        </form>

        <div id="deviceInfoView" class="hidden-info">
            <p class="mb-1 fs-5" data-translate="tracker.connectedDevice">Connected Device</p>
            <p id="connectedDeviceName" class="mb-1 fs-5">Connected Device</p>
            <button id="disconnectButton" class="w-100 btn btn-lg btn-primary" data-translate="tracker.disconnect">Disconnect</button>
            <button id="record-btn" class="btn btn-primary w-100" data-translate="tracker.startRecording">Start recording</button>
            <button id="saveRecord-btn" class="btn btn-primary w-100 hidden" data-translate="tracker.saveRecording">Save recording</button>
            <div class="text-danger formErrorMessage"></div>
        </div>
    </div>

    <div id="routes-section">
        <div class="text-danger formErrorMessage"></div>
        <div class="tracker-routes">
            <h3 data-translate="tracker.savedRoutes">Saved Routes</h3>
            <input type="text" id="route-search" placeholder="Search routes..." />
            <button id="search-btn">Search</button>
            <ul id="route-list"></ul>
            <!-- Навигация -->
            <div class="pagination-controls">
                <button id="prev-page" class="nav-button" disabled>
                    <span class="material-icons">chevron_left</span>
                </button>
                <span id="page-indicator">1</span>
                <button id="next-page" class="nav-button">
                    <span class="material-icons">chevron_right</span>
                </button>
            </div>
        </div>

        <div id="route-statistics" class="hidden">
            <div class="route-header">
            <span id="route-name-container" class="route-name-container">
                <input id="route-name-input" type="text" class="route-name-input" placeholder="Route Name" data-translate="tracker.routeName"/>
                <button id="save-route-name" class="btn btn-primary">
                    <span class="material-icons">save</span>
                </button>
            </span>
            </div>
            <p>
                <span data-translate="tracker.duration">Duration:</span>
                <span id="route-duration">00:00:00</span>
            </p>
            <p>
                <span data-translate="tracker.distance">Distance:</span>
                <span id="route-distance">0 km</span>
            </p>
            <p>
                <span data-translate="tracker.topSpeed">Top Speed:</span>
                <span id="route-top-speed">0 km/h</span>
            </p>

            <button id="delete-route" class="btn btn-danger btn-lg" data-translate="tracker.deleteRoute">Delete Route</button>
        </div>
    </div>

    <!-- Бутон за превключване -->
    <button id="toggle-view-btn" class="btn btn-primary w-100 mt-3" data-translate="tracker.viewSavedRoutes">View Saved Routes</button>

    <button id="toggle-menu">
        <svg class="svg-icon" style="width: 1em; height: 1em; vertical-align: middle; fill: currentColor; overflow: hidden; transition: transform 0.3s ease;"
             viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg">
            <path d="M768 785.066667a17.015467 17.015467 0 0 1-12.066133-5.000534l-256-256a17.0496 17.0496 0 0 1 0-24.132266l256-256a17.0496 17.0496 0 1 1 24.132266 24.132266L536.132267 512l243.933866 243.933867A17.0496 17.0496 0 0 1 768 785.066667z m-256 0a17.015467 17.015467 0 0 1-12.066133-5.000534l-256-256a17.0496 17.0496 0 0 1 0-24.132266l256-256a17.0496 17.0496 0 1 1 24.132266 24.132266L280.132267 512l243.933866 243.933867A17.0496 17.0496 0 0 1 512 785.066667z"/>
        </svg>
    </button>
</div>