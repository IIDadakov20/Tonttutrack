@using Tonttutrack.Domain.DTOs.Request;
@model UserRequestDTO;

<link rel="stylesheet" href="~/css/accountSettings.css" asp-append-version="true"/>

<ul class="navbar-nav">
    <li class="nav-item mx-sm-3">
        <!-- Dropdown за акаунт -->
        <div class="custom-dropdown">
            <button class="custom-dropdown-button">
                <img src="~/assets/accountProfilePicture.png" alt="Account Logo" class="custom-account-logo">
            </button>
            <div class="custom-dropdown-menu">
                <div class="account-name">@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value</div>
                <hr class="custom-dropdown-divider">
                <a class="custom-dropdown-item dropdown-settings" href="javascript:void(0);" id="settingsButton">Settings</a>
                <a class="custom-dropdown-item dropdown-log-out" asp-area="" asp-controller="Authentication" asp-action="Signout">Sign out</a>
            </div>
        </div>
    </li>
</ul>

<!-- Контент за акаунт настройките в попъп -->
<div id="settingsPopup" class="popup hidden">
    <div class="popup-content">
        <div class="settings-header">
            <h3 class="popup-title">Settings</h3>
            <button class="close-popup" id="closeSettingsPopup">✕</button>
            <hr>
        </div>

        <!-- Тъмна тема -->
        <div class="toggle">
            <span>Dark Theme</span>
            <div class="switch">
                <input type="checkbox" id="themeToggle">
                <label for="themeToggle">
                    <span class="slider"></span>
                </label>
            </div>
        </div>

        <div class="mydict">
            <span>Language</span>
            <div>
                <label for="lang-en">
                    <span>EN</span>
                    <input type="radio" id="lang-en" name="language" value="en">
                </label>
                <label for="lang-bg">
                    <span>BG</span>
                    <input type="radio" id="lang-bg" name="language" value="bg">
                </label>
            </div>
        </div>

        <!-- Бутони за обновяване и изтриване на акаунт -->
        <button id="updateAccountButton" class="update-btn">Update Account</button>
        
        <!-- Разкриване на полета за Update Account -->
        <div id="updateAccountFields" class="hidden">
            <form id="userUpdateForm">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Username" class="mb-1">Username</label>
                    <input asp-for="Username" class="form-control" value="@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="mb-1">Email</label>
                    <input asp-for="Email" class="form-control" value="@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-4">
                <button type="submit" class="btn btn-lg btn-primary">Update</button>
                </div>
            </form>
        </div>

        <button id="updatePasswordFieldsButton" class="update-btn">Update Password</button>

        <!-- Разкриване на полета за Update Password -->
        <div id="updatePasswordFields" class="hidden">
            <form asp-action="UpdatePassword" method="post">
                <div class="mb-3">
                    <label for="currentPassword" class="mb-1">Current Password</label>
                    <input type="password" id="currentPassword" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="newPassword" class="mb-1">New Password</label>
                    <input type="password" id="newPassword" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="confirmPassword" class="mb-1">Confirm New Password</label>
                    <input type="password" id="confirmPassword" class="form-control" />
                </div>
                <div class="col-4">
                    <button type="submit" class="btn btn-lg btn-primary">Update Password</button>
                </div>
                </form>
        </div>

        <button id="deleteAccountButton" class="delete-btn">Delete Account</button>

        <!-- Разкриване на поле за Delete Account -->
        <div id="deleteAccountFields" class="hidden">
            <form asp-action="DeleteAccount" method="post">
                <div class="mb-3">
                    <label for="deletePassword" class="mb-1">Enter Password to Delete</label>
                    <input type="password" id="deletePassword" class="form-control" />
                </div>
                <div class="col-4">
                <button type="submit" class="btn btn-lg btn-danger">DELETE</button>
                </div>
            </form>
            <div id="confirmationPopup" class="hidden">
                <p>Are you sure you want to delete your account?</p>
                <button id="cancelDeleteAccount" class="btn btn-secondary">Cancel</button>
                <button id="confirmDeleteAccount" class="btn btn-danger">Yes, Delete</button>
            </div>
        </div>
    </div>
</div>
<script src="~/js/accontSettings.js" asp-append-version="true"></script>
