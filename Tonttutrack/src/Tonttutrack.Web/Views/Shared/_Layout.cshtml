<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] | Tonttutrack</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Tonttutrack.Web.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/authenticationForms.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light pt-3">
        <div class="container-fluid px-5 mx-md-5 p-1">
            <a class="navbar-brand me-sm-5 fs-4" asp-area="" asp-controller="Home" asp-action="Index">Tonttutrack</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav">
                    <li class="nav-item mx-sm-3 fs-5">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item mx-sm-3 fs-5">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Map" asp-action="MapTrackerLayout">Map</a>
                    </li>
                </ul>
                @if (User.Identity == null || !User.Identity.IsAuthenticated)
                {
                <ul class="navbar-nav">
                    <li class="nav-item mx-sm-3 fs-5">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Authentication" asp-action="Login">Log in</a>
                    </li>
                </ul>
                }
                else
                {
                <ul class="navbar-nav">
                    <li class="nav-item mx-sm-3">
                        <!-- Dropdown за акаунт -->
                        <div class="custom-dropdown">
                            <button class="custom-dropdown-button">
                                <img src="account-logo.png" alt="Account Logo" class="custom-account-logo">
                            </button>
                            <div class="custom-dropdown-menu">
                                <div class="custom-dropdown-item account-name">Account Name</div>
                                <hr class="custom-dropdown-divider">
                                <a class="custom-dropdown-item" href="javascript:void(0);" id="settingsButton">Settings</a>
                                <a class="custom-dropdown-item" asp-area="" asp-controller="Authentication" asp-action="Signout">Sign out</a>
                            </div>
                        </div>
                    </li>
                </ul>
                }
            </div>
        </div>
    </nav>
</header>
<main role="main" class="box">
    @RenderBody()
</main>

<!-- Тук се добавят поп-ъпите -->
<div id="settingsPopup" class="popup hidden">
    <div class="popup-content">
        <button class="close-popup" id="closeSettingsPopup">✕</button>
        <h3 class="popup-title">Settings</h3>
        <hr>
        <div class="popup-body">
            <!-- Тъмна тема -->
            <div class="toggle">
                <span>Dark Theme</span>
                <div class="switch">
                    <input type="checkbox" id="themeToggle">
                    <label for="themeToggle">
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
            
            <div class="mydict">
                <span>Language</span>
                <div>
                    <label for="lang-en">
                        <span>EN</span>
                        <input type="radio" id="lang-en" name="language" value="en">
                    </label>
                    <label for="lang-bg">
                        <span>BG</span>
                        <input type="radio" id="lang-bg" name="language" value="bg">
                    </label>
                </div>
            </div>
            <!-- Бутони -->
            <button id="updateAccountButton" class="update-btn">Update Account</button>
            <button id="deleteAccountButton" class="delete-btn">Delete Account</button>
        </div>
    </div>
</div>

<!-- Поп-ъп за "Update Account" -->
<div id="updateAccountPopup" class="popup hidden">
    <div class="popup-content">
        <button class="close-popup" id="closeUpdateAccountPopup">✕</button>
        <h3 class="popup-title">Update Account</h3>
        <div class="popup-body">
            <p>Update your account details here.</p>
        </div>
    </div>
</div>

<!-- Поп-ъп за "Delete Account" -->
<div id="deleteAccountPopup" class="popup hidden">
    <div class="popup-content">
        <button class="close-popup" id="closeDeleteAccountPopup">✕</button>
        <h3 class="popup-title">Delete Account</h3>
        <div class="popup-body">
            <p>Are you sure you want to delete your account?</p>
            <button id="confirmDeleteAccount">Yes, Delete</button>
        </div>
    </div>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2024 - Tonttutrack - <a asp-area="" asp-controller="" asp-action="">Privacy</a>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
