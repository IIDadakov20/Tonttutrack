@model int?

@{
ViewData["Title"] = "Error";
}
<link rel="stylesheet" href="~/css/error.css">

<body style="background: url('/assets/error.webp') no-repeat center center fixed; background-size: cover;">

<div class="container">
    <div class="error-message">
        <h1>Oops! Something went wrong.</h1>

        @if (Model.HasValue)
        {
        <h1><strong>Error Code:</strong> <code>@Model</code></h1>
        }

        <button onclick="window.location.href='/'">Go to Home</button>
    </div>
</div>

</body>
